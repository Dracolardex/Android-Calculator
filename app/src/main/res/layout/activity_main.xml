<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="409dp"
        android:layout_height="400dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.454"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.990">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TableRow
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="#02E3A0">

                <Button
                    android:id="@+id/btnUno"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="1" />

                <Button
                    android:id="@+id/btnDos"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="2" />

                <Button
                    android:id="@+id/btnTres"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="3" />
            </TableRow>

            <TableRow
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="#02E3A0">

                <Button
                    android:id="@+id/btnCuatro"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="4" />

                <Button
                    android:id="@+id/btnCinco"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="5" />

                <Button
                    android:id="@+id/btnSeis"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="6" />
            </TableRow>

            <TableRow
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="#02E3A0">

                <Button
                    android:id="@+id/btnSiete"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="7" />

                <Button
                    android:id="@+id/btnOcho"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="8" />

                <Button
                    android:id="@+id/btnNueve"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="9" />
            </TableRow>

            <TableRow
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="#02E3A0">

                <Button
                    android:id="@+id/btnSuma"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="+" />

                <Button
                    android:id="@+id/btnCero"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="0" />

                <Button
                    android:id="@+id/btnResta"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="-" />
            </TableRow>

            <TableRow
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="#02E3A0">

                <Button
                    android:id="@+id/btnMultiplicar"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="*" />

                <Button
                    android:id="@+id/btnBorrar"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonBorrar"
                    android:text="C" />

                <Button
                    android:id="@+id/btnDivision"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonPulsado"
                    android:text="/" />
            </TableRow>

            <TableRow
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="#02E3A0">

                <Button
                    android:id="@+id/btnHacerCalculo"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_span="3"
                    android:layout_weight="1"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:onClick="botonCalcular"
                    android:text="Calcular" />

            </TableRow>

        </TableLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.287"
        android:text="0"
        android:textSize="50dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#02E3A0"
        android:gravity="center"
        android:text="CALCULADORA"
        android:textColor="#FFFF"
        android:textSize="50dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>